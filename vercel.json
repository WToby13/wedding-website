{
  "functions": {
    "api/photos.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/tennis/admin",
      "destination": "/tennis-admin.html"
    },
    {
      "source": "/photos",
      "destination": "/photos.html"
    },
    {
      "source": "/tennis",
      "destination": "/tennis.html"
    },
    {
      "source": "/rsvp/:path*",
      "destination": "/rsvp.html"
    }
  ]
}
